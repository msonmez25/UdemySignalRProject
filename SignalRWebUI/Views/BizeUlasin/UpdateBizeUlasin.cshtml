@model UpdateMessageDto
@{
    ViewData["Title"] = "UpdateBizeUlasin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Gelen Mailin Detayı</div>
                        </div>
                        <div class="card-body">

                            <input type="hidden" asp-for="MessageId" />

                            <div class="form-group">
                                <label>Ad Soyad</label>
                                <input type="text" class="form-control" asp-for="NameSurname" readonly>
                            </div>

                            <div class="form-group">
                                <label>Konu</label>
                                <input type="text" class="form-control" asp-for="Subject" readonly>
                            </div>

                            <div class="form-group">
                                <label>Mail İçeriği</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="MessageContent" rows="3" readonly></textarea>
                            </div>
                            <div class="form-group">
                                <label>Telefon</label>
                                <input type="text" class="form-control" asp-for="Phone" readonly>
                            </div>
                            <div class="form-group">
                                <label>Tarih</label>
                                <input type="text" class="form-control" asp-for="Date" readonly>
                            </div>

                        </div>
                        <div class="card-action">
                            <a href="/BizeUlasin/Index" class="btn btn-danger">Geri Dön</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

