@model List<ResultMessageDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Gelen Mailler Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                           Bize ulaşın menüsü üzerinden atılan maillerin listelendiği sayfadır.
                        </div>
                        <table id="bizeUlasinTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>Konu</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>Değiştir</th>
                                    <th>Detay</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.NameSurname</td>
                                        <td>@item.Subject</td>
                                        <td>@item.Date</td>
                                        @if (@item.Status == true)
                                        {
                                            <td>
                                                Okundu

                                            </td>
                                            <td>
                                                <a class="btn btn-warning" href="/BizeUlasin/MessageStatusChangeToFalse/@item.MessageId">
                                                    Okunmadı Yap
                                                </a>
                                            </td>

                                        }
                                        @if (@item.Status == false)
                                        {
                                            <td>
                                                Okunmadı
                                            </td>
                                            <td>
                                                <a class="btn btn-info" href="/BizeUlasin/MessageStatusChangeToTrue/@item.MessageId">
                                                    Okundu Yap
                                                </a>
                                            </td>

                                        }
                                        <td><a href="/BizeUlasin/UpdateBizeUlasin/@item.MessageId" class="btn btn-success">Detay Gör</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>


                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- DataTables Türkçe -->
    <script>
        $('#bizeUlasinTable').DataTable({
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
            },
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            responsive: true,
            order: [[2, 'asc']] // 🟢 3. sütun (0,1,2) = Tarih sütunu, azalan sırala
        });
    </script>
}