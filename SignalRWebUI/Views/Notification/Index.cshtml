@model List<ResultNotificationDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Bildirimler Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Bildirimler ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Bildirim Başlığı</th>
                                    <th scope="col">Tarih</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">Değiştir</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th>@count</th>
                                        <td>@item.Description</td>
                                        <td>@item.Date</td>

                                        @if (@item.Status == true)
                                        {
                                            <td>
                                                   Okundu
                                                
                                            </td>
                                            <td>
                                                <a class="btn btn-warning" href="/Notification/NotificationStatusChangeToFalse/@item.NotificationID">
                                                    Okunmadı Yap
                                                </a>
                                            </td>

                                        }
                                        @if (@item.Status == false)
                                        {
                                            <td>
                                                    Okunmadı
                                            </td>
                                            <td>
                                                <a class="btn btn-info" href="/Notification/NotificationStatusChangeToTrue/@item.NotificationID">
                                                    Okundu Yap
                                                </a>
                                            </td>

                                        }

                                        <td><a href="/Notification/DeleteNotification/@item.NotificationID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Notification/UpdateNotification/@item.NotificationID" class="btn btn-success">Güncelle</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>

                        <a href="/Notification/CreateNotification" class="btn btn-primary">Yeni Bildirim Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
