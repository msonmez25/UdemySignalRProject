@model List<ResultNotificationDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Bildirimler Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Bildirimler ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.
                        </div>
                        <table id="notificationTable" class="table table-hover table-bordered mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>Bildirim Başlığı</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>Değiştir</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th>@count</th>
                                        <td>@item.Description</td>
                                        <td>@item.Date</td>

                                        @if (@item.Status == true)
                                        {
                                            <td>
                                                   Okundu
                                                
                                            </td>
                                            <td>
                                                <a class="btn btn-warning" href="/Notification/NotificationStatusChangeToFalse/@item.NotificationID">
                                                    Okunmadı Yap
                                                </a>
                                            </td>

                                        }
                                        @if (@item.Status == false)
                                        {
                                            <td>
                                                    Okunmadı
                                            </td>
                                            <td>
                                                <a class="btn btn-info" href="/Notification/NotificationStatusChangeToTrue/@item.NotificationID">
                                                    Okundu Yap
                                                </a>
                                            </td>

                                        }

                                        <td><a href="/Notification/DeleteNotification/@item.NotificationID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Notification/UpdateNotification/@item.NotificationID" class="btn btn-success">Güncelle</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>
                        <br />
                        <a href="/Notification/CreateNotification" class="btn btn-primary">Yeni Bildirim Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- DataTables Türkçe -->
    <script>
        $(document).ready(function () {
            $('#notificationTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                responsive: true
                order: [[2, 'asc']]
            });
        });
    </script>
}