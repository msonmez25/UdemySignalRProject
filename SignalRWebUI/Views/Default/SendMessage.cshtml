                    @model CreateMessageDto

<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>Bize Ulaşın</h2>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form_container">
                    <!-- ✅ ID eklendi -->
                    <form id="contactForm" method="post" asp-action="SendMessage" asp-controller="Default">
                        <div>
                            <input type="text" class="form-control" placeholder="Adınız Soyadınız" asp-for="NameSurname" id="nameInput" />
                        </div>
                        <div>
                            <input type="email" class="form-control" placeholder="Mail" asp-for="Mail" id="mailInput" />
                        </div>
                        <div>
                            <input type="text" class="form-control" placeholder="Telefon" asp-for="Phone" id="phoneInput" />
                        </div>
                        <div>
                            <input type="text" class="form-control" placeholder="Konu" asp-for="Subject" id="subjectInput" />
                        </div>
                        <div>
                            <textarea asp-for="MessageContent" rows="5" placeholder="Mesajınızı yazınız" class="form-control" id="messageInput"></textarea>
                        </div>

                        <div class="btn_box">
                            <!-- ✅ type="button" olmalı -->
                            <button type="button" id="btnBizeUlasin" class="btn btn-theme">
                                Mesajını Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-md-6">
                <div class="map_container ">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2530.2188536892018!2d28.918783066742755!3d41.048129263766675!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab1bcf607ae4b%3A0x3adb57b070b269a0!2zUmFtaSBLw7x0w7xwaGFuZXNpIEEgS2FwxLFzxLEgKEjDvG5rYXIgS2FwxLFzxLEp!5e0!3m2!1str!2str!4v1760072068390!5m2!1str!2str" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ✅ SweetAlert2 -->
<script src="//code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $("#btnBizeUlasin").click(function (e) {
            e.preventDefault();

            const name = $("#nameInput").val().trim();
            const mail = $("#mailInput").val().trim();
            const phone = $("#phoneInput").val().trim();
            const subject = $("#subjectInput").val().trim();
            const message = $("#messageInput").val().trim();

            if (!name || !mail || !phone || !subject || !message) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen tüm alanları doldurunuz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            $.ajax({
                type: "POST",
                url: "/Default/SendMessage",
                data: $("#contactForm").serialize(),
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Tebrikler!",
                            text: response.message,
                            showConfirmButton: false,
                            timer: 2000
                        });

                        $("#contactForm")[0].reset();
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Hata!",
                            text: response.message,
                            confirmButtonText: "Tamam"
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Hata!",
                        text: "Sunucuya bağlanırken bir sorun oluştu.",
                        confirmButtonText: "Tamam"
                    });
                }
            });
        });
    });
</script>
