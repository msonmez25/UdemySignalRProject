@model List<ResultRestaurantTableDto>
@{
    ViewData["Title"] = "TableListByStatus";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    .table-card {
        display: flex;
        align-items: center;
        justify-content: center; /* ✅ Yatayda ortala */
        text-align: left;
        height: 130px;
        width: 100%;
        border-radius: 12px;
        font-weight: 600;
        color: #fff;
        padding: 20px;
        transition: all .25s ease;
        user-select: none;
        gap: 16px;
        padding-left:75px;
    }

    .table-card-icon {
        font-size: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        flex-shrink: 0;
    }

    .table-card-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex-grow: 1;
        text-align: left;
    }

    .table-card-name {
        font-size: 20px;
        margin-bottom: 6px;
        font-weight: 700;
    }

    .table-card-status {
        font-size: 14px;
        opacity: 0.9;
    }

    .free {
        background: #28a745 !important; /* Boş Masa = Yeşil */
    }

    .full {
        background: #dc3545 !important; /* Dolu Masa = Kırmızı */
    }

    .table-card:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 15px rgba(0,0,0,0.18);
        cursor: pointer;
    }

    .page-title i {
        margin-right: 8px;
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title mb-4">
            <i class="fa-solid fa-border-all"></i> Anlık Masa Durumları
        </h4>

        <div id="tablelist" class="row">
            @foreach (var item in Model)
            {
                var statusClass = item.Status ? "full" : "free";
                var statusText = item.Status ? "Masa Dolu" : "Masa Boş";
                var icon = item.Status ? "fa-utensils" : "fa-chair";

                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">
                    <div class="table-card @statusClass" data-id="@item.RestaurantTableID">
                        <div class="table-card-icon">
                            <i class="fa-solid @icon"></i>
                        </div>
                        <div class="table-card-content">
                            <div class="table-card-name">@item.Name</div>
                            <div class="table-card-status">@statusText</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7195/SignalRHub").build();

        connection.start().then(() => {
            console.log("✅ SignalR Bağlantısı Başarılı");
            setInterval(() => {
                connection.invoke("GetRestaurantTableStatus");
            }, 1000);
        });

        connection.on("ReceiveGetRestaurantTableStatus", (tables) => {
            tables.forEach((t) => {
                var card = $(`[data-id='${t.restaurantTableID}']`);

                if (!card.length) return;

                if (t.status === true) {
                    card.removeClass("free").addClass("full");
                    card.find("i").removeClass("fa-chair").addClass("fa-utensils");
                    card.find(".table-card-status").text("Masa Dolu");
                }
                else {
                    card.removeClass("full").addClass("free");
                    card.find("i").removeClass("fa-utensils").addClass("fa-chair");
                    card.find(".table-card-status").text("Masa Boş");
                }
            });
        });

    });
</script>