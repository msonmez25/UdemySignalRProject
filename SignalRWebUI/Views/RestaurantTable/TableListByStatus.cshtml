@model List<ResultRestaurantTableDto>
@{
    ViewData["Title"] = "TableListByStatus";
    Layout = "~/Views/AdminLayout/Index.cshtml";

}


<style>
    .card .card-body {
        padding: 25px 10px 25px 15px;
    }

    .card .card-category {
        font-size: 17px;
    }

</style>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>


<div class="content">
    <div class="container-fluid">

        <!-- SignalR ile verinin çekilmesi start  -->
        <script type="text/javascript">

            $(document).ready(() => {

                var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7195/SignalRHub").build();
                $("#connstatus").text(connection.state);

                connection.start().then(() => {
                    $("#connstatus").text(connection.state);
                    setInterval(() => {
                        connection.invoke("GetRestaurantTableStatus");
                    }, 1000);

                }).catch((err) => { console.log(err) });

                //---------------------------------------------------------------------------
                //Masa Listei
                connection.on("ReceiveGetRestaurantTableStatus", (value) => {
                    console.log(value);
                    var color = "";
                    var masaDurum = "";
                    var iconClass = "";
                    let tablehtml = `<div class="row">`;

                    $.each(value, (index, item) => {

                        if (item.status == false) {
                            color = "card card-stats card-success";
                            masaDurum = "Masa Boş";
                            iconClass = "fa-solid fa-chair"; // ✅ boş masa ikonu
                        }
                        else {
                            color = "card card-stats card-danger";
                            masaDurum = "Masa Dolu";
                            iconClass = "fa-solid fa-utensils"; // ✅ dolu masa ikonu
                        }

                        tablehtml += `
                        <div class="col-md-3">
                            <div class="${color}">
                                <div class="card-body ">
                                    <div class="row">
                                        <div class="col-5">
                                            <div class="icon-big text-center">
                                                <i class="${iconClass}"></i>
                                            </div>
                                        </div>
                                        <div class="col-7 d-flex align-items-center">
                                            <div class="numbers">
                                                <p class="card-category">${item.name}</p>
                                                <h4 class="card-title">${masaDurum}</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                    });

                    tablehtml += `</div>`;
                    $("#tablelist").html(tablehtml);
                });

            });
        </script>
        <!-- SignalR ile verinin çekilmesi end  -->

        <h4 class="page-title">Anlik Masa Durumları Sayfası</h4>

        <div id="tablelist"></div>


    </div>
</div>

