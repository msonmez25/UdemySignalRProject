@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Hakkımızda Yazısı Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub mb-3">
                            Hakkımızda alanı ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz. Tema bütünlüğü için sadece bir tane kayıt olmalıdır.
                        </div>
                        <table id="aboutTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th>Başlık</th>
                                    <th>Açıklama</th>
                                    <th>Durumu</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Title</td>
                                        <td title="@item.Description">
                                            @(item.Description?.Length > 100
                                                ? item.Description.Substring(0, 100) + "..."
                                                : item.Description)
                                        </td>
                                        <td>@(item.Status ? "Aktif" : "Pasif")</td>
                                        <td>
                                            <a href="/About/DeleteAbout/@item.AboutID" class="btn btn-danger"
                                               onclick="return confirm('Bu yazıyı silmek istediğinizden emin misiniz?');">
                                                Sil
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/About/UpdateAbout/@item.AboutID" class="btn btn-success">Güncelle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <br />
                        <a href="/About/CreateAbout" class="btn btn-primary mt-3">Yeni Hakkımda Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- DataTables Türkçe -->
    <script>
        $(document).ready(function () {
            $('#aboutTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50]
            });
        });
    </script>
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
}
