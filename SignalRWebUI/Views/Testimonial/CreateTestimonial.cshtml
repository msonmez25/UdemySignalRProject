@model CreateTestimonialDto
@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Müşteri Memnuniyet Yazıları Ekleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <div class="form-group">
                                <label>Ad Soyad</label>
                                <input type="text" class="form-control" asp-for="Name">
                            </div>

                            <div class="form-group">
                                <label>Ünvan</label>
                                <input type="text" class="form-control" asp-for="Title">
                            </div>

                            <div class="form-group">
                                <label>Yorum</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="Comment" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <label>Görsel URL</label>
                                <input type="text" class="form-control" asp-for="ImageUrl">
                            </div>


                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Müşteri Memnuniyet Yazısı Ekle</button>
                            <a href="/Testimonial/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>


