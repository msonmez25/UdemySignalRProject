@model UpdateOpenInfoDto
@{
    ViewData["Title"] = "UpdateOpenInfo";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Çalışma Saatleri Bilgisi Güncelleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <input type="hidden" asp-for="OpenInfoID" />

                            <div class="form-group">
                                <label>Başlık</label>
                                <input type="text" class="form-control" asp-for="Title">
                            </div>

                            

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="Description" rows="3"></textarea>
                            </div>

                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Çalışma Saatleri Güncelle</button>
                            <a href="/OpenInfo/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

