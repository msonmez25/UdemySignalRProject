@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<div class="content">
    <div class="container-fluid">

        <!-- SignalR ile verinin çekilmesi start  -->
        <script type="text/javascript">

            $(document).ready(() => {

                var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7195/SignalRHub").build();
                $("#connstatus").text(connection.state);

                connection.start().then(() => {
                    $("#connstatus").text(connection.state);
                    setInterval(() => {
                        connection.invoke("SendStatistic");
                    }, 1000);

                }).catch((err) => { console.log(err) });

                //---------------------------------------------------------------------------
                //İlk Satır
                //Kategori Sayısı
                connection.on("ReceiveCategoryCount", (value) => {
                    $("#categorycount").text(value);
                });


                //Aktif Kategori Sayısı
                connection.on("ReceiveActiveCategoryCount", (value) => {
                    $("#activecategorycount").text(value);
                });


                //Pasif Kategori Sayısı
                connection.on("ReceivePassiveCategoryCount", (value) => {
                    $("#passivecategorycount").text(value);
                });

                //Ürün Sayısı
                connection.on("ReceiveProductCount", (value) => {
                    $("#productcount").text(value);
                });

                //---------------------------------------------------------------------------
                //İkinci Satır
                //Hamburger Kategorisi Ürün Sayısı
                connection.on("ReceiveHamburgerProductCount", (value) => {
                    $("#hamburgerproductcount").text(value);
                });

                //İçecek Kategorisi Ürün Sayısı
                connection.on("ReceiveDrinkProductCount", (value) => {
                    $("#drinkproductcount").text(value);
                });

                //Ortalama Ürün Fiyat
                connection.on("ReceiveAvgPriceProduct", (value) => {
                    $("#avgproductprice").text(value);
                });

                //Ortalama Hamburger Fiyat
                connection.on("ReceiveHamburgerAvgPriceProduct", (value) => {
                    $("#hamburgeravgproductprice").text(value);
                });

                //---------------------------------------------------------------------------
                //Üçüncü Satır
                //En Ucuz Ürün
                connection.on("ReceiveNameByPriceMin", (value) => {
                    $("#minpriceproductname").text(value);
                });

                //En Pahalı Ürün
                connection.on("ReceiveNameByPriceMax", (value) => {
                    $("#maxpriceproductname").text(value);
                });

                //Toplam Sipariş Sayısı
                connection.on("ReceiveTotalOrderCount", (value) => {
                    $("#totalordercount").text(value);
                });
                                
                //Aktif Sipariş Sayısı
                connection.on("ReceiveActiveOrderCount", (value) => {
                    $("#activeordercount").text(value);
                });

                //---------------------------------------------------------------------------
                //Dördüncü Satır
                //Son Sipariş Tutarı
                connection.on("ReceiveLastOrderPrice", (value) => {
                    $("#lastorderprice").text(value);
                });

                //Kasadaki Tutar
                connection.on("ReceiveTotalMoneyCaseAmount", (value) => {
                    $("#totalmoneycaseamount").text(value);
                });

                //Bugünki Kazanç
                connection.on("ReceiveTodayTotalPrice", (value) => {
                    $("#todaytotalprice").text(value);
                });


                //Masa Sayısı
                connection.on("ReceiveCountTable", (value) => {
                    $("#tablecount").text(value);
                });

            });
        </script>
        <!-- SignalR ile verinin çekilmesi end  -->

