@{
    ViewData["Title"] = "Anlık İstatistik";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<style>
    .card.card-stats {
        border: none;
        border-radius: 18px;
        padding: 22px 18px;
        transition: all .25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 140px;
    }

        .card.card-stats:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .15);
        }

    .card-body {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
    }

    .icon-big {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card .icon-big i {
        font-size: 48px;
        opacity: 0.95;
    }

    .card-category {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 4px;
        opacity: 0.95;
        font-weight: bold !important;
        color: white !important;
    }

    .card-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0;
        opacity: 1;
        font-weight: bold !important;
        color: white !important;
    }

    .page-title {
        font-size: 28px !important;
        font-weight: 800 !important;
        margin-bottom: 20px;
        color: #222;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    @@media(max-width: 768px) {
        .card .icon-big i {
            font-size: 38px;
        }

        .card-title {
            font-size: 22px;
        }
    }

</style>


<script type="text/javascript">
    $(document).ready(() => {

        var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7195/SignalRHub").build();
        $("#connstatus").text(connection.state);

        connection.start().then(() => {
            $("#connstatus").text(connection.state);
            setInterval(() => {
                connection.invoke("SendStatistic");
            }, 1000);

        }).catch((err) => { console.log(err) });


        //📌  1.Satır
        connection.on("ReceiveTodayTotalPrice", (value) => { $("#todaytotalprice").text(value); });
        connection.on("ReceiveLastOrderPrice", (value) => { $("#lastorderprice").text(value); });
        connection.on("ReceiveTotalMoneyCaseAmount", (value) => { $("#totalmoneycaseamount").text(value); });
        connection.on("ReceiveActiveBookingCount", (value) => { $("#activebookingcount").text(value); });

        //📌 2.Satır
        connection.on("ReceiveMostOrderedProductName", (value) => { $("#mostorderedproductname").text(value); });
        connection.on("ReceiveMostOrderedTableName", (value) => { $("#mostorderedtablename").text(value); });
        connection.on("ReceiveTotalBookingCount", (value) => { $("#totalbookingcount").text(value); });
        connection.on("ReceiveTotalOrderCount", (value) => { $("#receivetotalordercount").text(value); });

        //📌 3.Satır
        connection.on("ReceiveHamburgerAvgPriceProduct", (value) => { $("#hamburgeravgproductprice").text(value); });
        connection.on("ReceiveProductAvgPriceByPizza", (value) => { $("#pizzaavgproductprice").text(value); });
        connection.on("ReceiveProductAvgPriceByPasta", (value) => { $("#pastaavgproductprice").text(value); });
        connection.on("ReceiveProductAvgPriceByDessert", (value) => { $("#dessertavgproductprice").text(value); });

        //📌 4.Satır
        connection.on("ReceiveCategoryCount", (value) => { $("#categorycount").text(value); });
        connection.on("ReceiveProductCount", (value) => { $("#productcount").text(value); });
        connection.on("ReceiveNameByPriceMin", (value) => { $("#minpriceproductname").text(value); });
        connection.on("ReceiveNameByPriceMax", (value) => { $("#maxpriceproductname").text(value); });

    });
</script>



<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">📊 Anlık İstatistikler</h4>

        <!-- ✅ 1. Satır -->
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-warning text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center">
                            <div class="icon-big"><i class="la la-money"></i></div>
                        </div>
                        <div class="col-8">
                            <p class="card-category">Bugünkü Kazanç</p>
                            <h4 id="todaytotalprice" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-success text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><div class="icon-big"><i class="la la-shopping-cart"></i></div></div>
                        <div class="col-8">
                            <p class="card-category">Son Sipariş</p>
                            <h4 id="lastorderprice" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><div class="icon-big"><i class="la la-bank"></i></div></div>
                        <div class="col-8">
                            <p class="card-category">Kasadaki Tutar</p>
                            <h4 id="totalmoneycaseamount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><div class="icon-big"><i class="la la-cutlery"></i></div></div>
                        <div class="col-8">
                            <p class="card-category">Aktif Sipariş</p>
                            <h4 id="activebookingcount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- ✅ 2. Satır -->
        <div class="row g-3 mt-2">
            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-warning text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-star"></i></div>
                        <div class="col-8">
                            <p class="card-category">En Çok Ürün</p>
                            <h4 id="mostorderedproductname" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-success text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-table"></i></div>
                        <div class="col-8">
                            <p class="card-category">En Çok Masa</p>
                            <h4 id="mostorderedtablename" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-calendar-check-o"></i></div>
                        <div class="col-8">
                            <p class="card-category">Rezervasyon</p>
                            <h4 id="totalbookingcount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-list-ul"></i></div>
                        <div class="col-8">
                            <p class="card-category">Toplam Sipariş</p>
                            <h4 id="receivetotalordercount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- ✅ 3. Satır -->
        <div class="row g-3 mt-2">
            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-warning text-white">
                    <div class="card-body d-flex align-items-center justify-content-center gap-3">
                        <div class="icon-big">
                            <i class="fas fa-hamburger"></i>
                        </div>
                        <div>
                            <p class="card-category">Hamburger Ort.</p>
                            <h4 id="hamburgeravgproductprice" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-success text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-pie-chart"></i></div>
                        <div class="col-8">
                            <p class="card-category">Pizza Ort.</p>
                            <h4 id="pizzaavgproductprice" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-spoon"></i></div>
                        <div class="col-8">
                            <p class="card-category">Makarna Ort.</p>
                            <h4 id="pastaavgproductprice" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-birthday-cake"></i></div>
                        <div class="col-8">
                            <p class="card-category">Tatlı Ort.</p>
                            <h4 id="dessertavgproductprice" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- ✅ 4. Satır -->
        <div class="row g-3 mt-2">
            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-warning text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-tags"></i></div>
                        <div class="col-8">
                            <p class="card-category">Kategori</p>
                            <h4 id="categorycount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-success text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-cubes"></i></div>
                        <div class="col-8">
                            <p class="card-category">Ürün</p>
                            <h4 id="productcount" class="card-title">0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-angle-down"></i></div>
                        <div class="col-8">
                            <p class="card-category">En Ucuz</p>
                            <h4 id="minpriceproductname" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-stats bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-4 text-center"><i class="icon-big la la-angle-up"></i></div>
                        <div class="col-8">
                            <p class="card-category">En Pahalı</p>
                            <h4 id="maxpriceproductname" class="card-title"></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
