@model List<ResultDiscountDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Günün İndirimli Ürünleri Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Günün İndirimli ürünleri ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.Tema bütünlüğü için sadece <strong>2 ve 2'in katı ÜrÜn Aktif </strong> olmalıdır.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ürün</th>
                                    <th scope="col">İndirim Oranı</th>
                                    <th scope="col">Durumu</th>
                                    <th scope="col">Durum Değiştir</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th>@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.Amount</td>
                                        @if (@item.Status == true)
                                        {
                                            <td>Ürün Aktif</td>
                                        }
                                        else
                                        {
                                            <td>Ürün Kapalı</td>
                                        }
                                        @if (@item.Status == true)
                                        {
                                            <td><a href="/Discount/DisCountStatusChangeFalse/@item.DiscountID" class="btn btn-dark">Pasif Yap</a></td>
                                        }
                                        else
                                        {
                                            <td><a href="/Discount/DisCountStatusChangeTrue/@item.DiscountID" class="btn btn-warning">Aktif Yap</a></td>
                                        }

                                        
                                        <td><a href="/Discount/DeleteDiscount/@item.DiscountID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Discount/UpdateDiscount/@item.DiscountID" class="btn btn-success">Güncelle</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>

                        <a href="/Discount/CreateDiscount" class="btn btn-primary">Yeni İndirimli Ürün Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
