@model List<ResultDiscountDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Günün İndirimli Ürünleri Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub mb-3">
                            Günün indirimli ürünleri ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.
                            Tema bütünlüğü için sadece <strong>2 ve 2'nin katı ürün aktif</strong> olmalıdır.
                        </div>

                        <table id="discountTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                           <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>Ürün</th>
                                    <th>İndirim Oranı</th>
                                    <th>Durumu</th>
                                    <th>Durum Değiştir</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Title</td>
                                        <td>%@item.Amount</td>
                                        <td>
                                            @(item.Status ? "Ürün Aktif" : "Ürün Kapalı")
                                        </td>
                                        <td>
                                            @if (item.Status)
                                            {
                                                <a href="/Discount/DisCountStatusChangeFalse/@item.DiscountID" class="btn btn-dark btn-sm">Pasif Yap</a>
                                            }
                                            else
                                            {
                                                <a href="/Discount/DisCountStatusChangeTrue/@item.DiscountID" class="btn btn-warning btn-sm">Aktif Yap</a>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Discount/DeleteDiscount/@item.DiscountID" class="btn btn-danger btn-sm"
                                               onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                                                Sil
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/Discount/UpdateDiscount/@item.DiscountID" class="btn btn-success btn-sm">Güncelle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <br />
                        <a href="/Discount/CreateDiscount" class="btn btn-primary mt-3">Yeni İndirimli Ürün Ekle</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- DataTables Türkçe -->
    <script>
        $(document).ready(function () {
            $('#discountTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                responsive: true
            });
        });
    </script>
}
