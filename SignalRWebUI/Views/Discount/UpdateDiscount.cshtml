@model UpdateDiscountDto
@{
    ViewData["Title"] = "UpdateDiscount";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">İndirimli Ürün Ekleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <input type="hidden" asp-for="DiscountID"/>
                            <div class="form-group">
                                <label>Ürün Adı</label>
                                <input type="text" class="form-control" asp-for="Title">
                            </div>

                            <div class="form-group">
                                <label>Ürün İndirim Oranı</label>
                                <input type="text" class="form-control" asp-for="Amount">
                            </div>

                            <div class="form-group">
                                <label>Görsel URL</label>
                                <input type="text" class="form-control" asp-for="ImageUrl">
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="Description" rows="3"></textarea>
                            </div>

                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">İndirimli Ürünü Güncelle</button>
                            <a href="/Discount/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>




