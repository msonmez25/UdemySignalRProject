@model UpdateCategoryDto
@{
    ViewData["Title"] = "UpdateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Kategori Güncelleme İşlemleri</div>
                        </div>
                        <div class="card-body">
                            <input type="hidden" asp-for="CategoryID"/>
                            <div class="form-group">
                                <label>Kategori Adı</label>
                                <input type="text" class="form-control" asp-for="CategoryName">
                            </div>

                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Kategoriyi Güncelle</button>
                            <a href="/Category/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

