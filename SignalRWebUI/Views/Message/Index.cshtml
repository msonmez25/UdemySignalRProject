
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeadComponentPartial")

<body class="sub_page">

    @await Component.InvokeAsync("_UILayoutNavbarComponentPartial")
    </div>

    <!-- Message Inside Start  -->

    <div class="container-fluid">
        <div class="row pt-xxl-5 mt-5">
            <div class="col-12">
                <nav class="breadcrumb bg-dark mb-30">
                    <a class="breadcrumb-item text-white" href="/Default/Index/">Ana Sayfa</a>
                    <a class="breadcrumb-item text-white" href="/Message/Index/">Mesajlaşma</a>
                    <span class="breadcrumb-item active">Restoran Anlık Mesajlaşma</span>
                </nav>
            </div>
        </div>
    </div>


    <section class="food_section">
        <div class="container">

            <div class="container mt-5">
                <div class="row">
                    <div class="col-12">
                        <h3 class="text-center mb-4">SignalR Restoran Anlık Mesajlaşma</h3>
                    </div>
                </div>


                <div class="row p-1">
                    <div class="col-2">Kullanıcı Adınız:</div>
                    <div class="col-5">
                        <input type="text" id="userinput" class="form-control" />
                    </div>
                </div>


                <div class="row p-1">
                    <div class="col-2">Mesajınız:</div>
                    <div class="col-5">
                        <input type="text" class="form-control" id="messageinput" />
                    </div>
                </div>


                <div class="row p-1">
                    <div class="col-2"></div>
                    <div class="col-3">
                        <input type="button" id="sendbutton" value="Mesaj Gönder" class="btn btn-warning" />
                    </div>
                </div>


                <div class="row p-1">
                    <div class="col-12">
                        <hr />
                    </div>
                </div>


                <div class="row p-1">
                    <div class="col-12">
                        <ul id="messagelist" class="list-group"></ul>
                    </div>
                </div>
            </div>

        </div>

    </section>
    <!-- Message Inside End -->

    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")

    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.8/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>


</body>

</html>