@{
    Layout = null;
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@removeTagHelper *, Microsoft.AspNetCore.Mvc.Razor.TagHelpers

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 | Sonmez Restaurant</title>

    <link rel="stylesheet" href="~/errorpages/HTML/main/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/errorpages/HTML/main/assets/fonts/font-awesome/css/font-awesome.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #a1aab6 0%, #a1aab6 100%);
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
        }

        .error-box {
            text-align: center;
            padding: 30px;
        }

        .error-logo img {
            height: 150px;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 5px rgba(0, 0, 0, .4));
        }

        .error-title {
            font-size: 140px;
            font-weight: 900;
            margin: 0;
            background: linear-gradient(90deg,rgba(24, 40, 74, 1) 0%, rgba(24, 93, 158, 1) 50%, rgba(91, 109, 143, 1) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .error-sub {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        p {
            font-size: 18px;
            margin-bottom: 35px;
        }

        .btn-404 {
            padding: 14px 32px;
            border-radius: 40px;
            margin: 10px;
            color: #fff;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .btn-home {
            color: #ffffff;
            background-color: #eb8821;
            border-color: #eb8821
        }

            .btn-home:hover{
                color: #ffffff;
                background-color: #e69c00;
                border-color: #e69c00
            }

        .btn-back {
            color: #ffffff;
            background-color: #00c9a6;
            border-color: #00c9a6;
        }

        .btn-back:hover{
                color: #ffffff;
                background-color: #00a386;
                border-color: #00967c;
        }

        .btn-404:hover {
            opacity: 0.9;
            transform: translateY(-3px);
            color: #fff;          
        }

        a {
            text-decoration: none !important;
        }

            a:hover {
                text-decoration: none !important;
            }
    </style>
</head>

<body>
    <div class="error-box">
        <div class="error-logo">
            <img src="@Url.Content("~/errorpages/documentation/assets/images/rest.png")" alt="Logo">
        </div>

        <h1 class="error-title">404</h1>
        <h2 class="error-sub">Üzgünüz :(</h2>
        <p>Aradığınız sayfaya ulaşamadık! Belki bağlantı yanlış ya da sayfa taşınmış olabilir.</p>

        <div>
            <a href="/Default/Index/" class="btn-404 btn-home">
                 Ana Sayfa
            </a>

            <button class="btn-404 btn-back" onclick="history.back()">
                 Geri Dön
            </button>
        </div>
    </div>
</body>
</html>
