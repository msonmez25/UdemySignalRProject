@model RegisterDto
@{
    Layout = null;
}


<!--
Author: W3layouts
Author URL: http://w3layouts.com
-->
<!DOCTYPE html>
<html lang="zxx">

<head>
    <title>SignalR Restaurant Kayıt</title>
    <link rel="shortcut icon" href="~/miri-ui/docs/assets/images/icohamburger.ico" type="image/x-icon">
    <!-- Meta tag Keywords -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="UTF-8" />
    <meta name="keywords"
          content="Invent Signup Form Responsive web template, Bootstrap Web Templates, Flat Web Templates, Android Compatible web template, Smartphone Compatible web template, free webdesigns for Nokia, Samsung, LG, SonyEricsson, Motorola web design" />
    <script>
        addEventListener("load", function () {
            setTimeout(hideURLbar, 0);
        }, false);

        function hideURLbar() {
            window.scrollTo(0, 1);
        }
    </script>
    <!-- //Meta tag Keywords -->
    <!--/Style-CSS -->
    <link rel="stylesheet" href="~/web/css/style.css" type="text/css" media="all" />
    <!--//Style-CSS -->


    <style type="text/css">
        .text-danger {
            color: red;
            font-weight: bold;
        }

        .features {
            text-align: left;
            margin-bottom: 25px;
            list-style-type: none;
        }

            .features li {
                margin-bottom: 10px;
                margin-left:80px;
                font-size: 15px;
            }
    </style>
</head>

<body>
    <!-- /login-section -->
    <section class="w3l-login-6">
        <div class="login-hny">
            <div class="form-content">
                <div class="form-right">
                    <div class="overlay">
                        <div class="grid-info-form">
                            <h3>SignalR Restaurant</h3>
                            <h3>Lezzet Dolu Bir Deneyim İçin Kaydolun!</h3>
                            <p>
                                Restoranımıza özel fırsatları kaçırmayın!
                                Kayıt olarak size özel kampanyalardan, indirimlerden ve yeni menülerimizden ilk siz haberdar olun.

                                <ul class="features">
                                    <li>✅ Hızlı ve kolay kayıt</li>
                                    <li>✅ Üyelere özel ayrıcalıklar</li>
                                    <li>✅ Rezervasyonlarınızı zahmetsizce yönetin</li>
                                </ul>

                                📩 Şimdi kaydolun, lezzetin ayrıcalığını yaşayın!
                            </p>
                            <a href="/Login/Index" class="read-more-1 btn">Hadİ başlayalım</a>
                        </div>

                    </div>
                </div>
                <div class="form-left" style="height: calc(100vh - 125px);">
                    <div class="middle">
                        <h4>BİZE KATILIN</h4>
                        <p>Hemen ücretsiz hesap oluşturun :)</p>
                    </div>
                    <form method="post" class="signin-form">
                        <div class="form-input">
                            <label>Adınız</label>
                            <input type="text" asp-for="Name" required />
                            
                        </div>
                        <div class="form-input">
                            <label>Soyadınız</label>
                            <input type="text" asp-for="Surname" required />
                           
                        </div>
                        <div class="form-input">
                            <label>Kullanıcı Adınız</label>
                            <input type="text" asp-for="UserName" required />
                           
                        </div>
                        <div class="form-input">
                            <label>Mail Adresiniz</label>
                            <input type="email" asp-for="Mail" required />
                           
                        </div>
                        <div class="form-input">
                            <label>Şifre</label>
                            <input type="password" asp-for="Password" required />
                        </div>
                       
                        <div class="text-danger" asp-validation-summary="ModelOnly">
                        </div>
                        <label class="container">
                            Şartları Okudum <a href="#">Kabul Ediyorum</a>
                            <input type="checkbox">
                            <span class="checkmark"></span>
                        </label>
                        <button class="btn">Kayıt Ol</button>
                    </form>
                    <div class="copy-right text-center">
                        <p>
                            © @DateTime.Now.Year SignalR Restaurant. Tüm hakları saklıdır.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>
    <!-- //login-section -->
</body>

</html>
