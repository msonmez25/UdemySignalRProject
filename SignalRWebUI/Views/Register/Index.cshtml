@model RegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Sönmez Restoran - Kayıt Ol</title>
    <link rel="shortcut icon" href="~/miri-ui/docs/assets/images/icohamburger.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="UTF-8" />
    <meta name="keywords" content="Restoran, Kayıt, Üyelik, Sönmez Restoran" />
    
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: #eb8821;
            --primary-dark: #E69C00;
            --secondary-color: #2c3e50;
            --accent-color: #f39c12;
            --light-color: #f8f9fa;
            --dark-color: #343a40;
            --success-color: #27ae60;
            --error-color: #e74c3c;
            --border-radius: 10px;
            --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #a1aab6 0%, #a1aab6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            display: flex;
            max-width: 1100px;
            width: 100%;
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--box-shadow);
        }

        .left-section {
            flex: 1;
            background: linear-gradient(rgba(44, 62, 80, 0.85), rgba(44, 62, 80, 0.9)), url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1170&q=80') no-repeat center center;
            background-size: cover;
            color: white;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--accent-color);
        }

        .left-content h2 {
            font-size: 32px;
            margin-bottom: 20px;
            line-height: 1.3;
        }

        .left-content p {
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .features {
            list-style-type: none;
            margin-bottom: 30px;
        }

        .features li {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            font-size: 15px;
        }

        .features i {
            color: var(--accent-color);
            margin-right: 10px;
            font-size: 18px;
        }

        .btn-outline {
            display: inline-block;
            padding: 12px 30px;
            border: 2px solid white;
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            transition: var(--transition);
            text-align: center;
        }

        .btn-outline:hover {
            background: white;
            color: var(--secondary-color);
        }

        .right-section {
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .form-header h2 {
            color: var(--secondary-color);
            font-size: 28px;
            margin-bottom: 10px;
        }

        .form-header p {
            color: #6c757d;
            font-size: 15px;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--secondary-color);
        }

        .form-control {
            width: 100%;
            padding: 14px 15px;
            border: 1px solid #ddd;
            border-radius: var(--border-radius);
            font-size: 15px;
            transition: var(--transition);
            font-family: 'Poppins', sans-serif;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.1);
            outline: none;
        }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 42px;
            color: #6c757d;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .checkbox-container input {
            margin-right: 10px;
        }

        .checkbox-container a {
            color: var(--primary-color);
            text-decoration: none;
        }

        .checkbox-container a:hover {
            text-decoration: underline;
        }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: var(--border-radius);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Poppins', sans-serif;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
            font-size: 15px;
        }

        .login-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .copyright {
            text-align: center;
            margin-top: 30px;
            font-size: 14px;
            color: #6c757d;
        }

        .text-danger {
            color: var(--error-color);
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary {
            background: #ffeaea;
            color: var(--error-color);
            padding: 10px 15px;
            border-radius: var(--border-radius);
            margin-bottom: 20px;
            font-size: 14px;
        }

        media (max-width: 768px) {
            .container {
                flex-direction: column;
            }
            
            .left-section {
                padding: 30px 20px;
            }
            
            .right-section {
                padding: 30px 20px;
            }

        /* Alternatif 1 için */
        .highlight-text {
            font-size: 18px;
            font-style: italic;
            color: #f8f9fa;
            background: linear-gradient(45deg, #e74c3c, #f39c12);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .premium-benefits h3 {
            color: #f39c12;
            margin-bottom: 20px;
        }

        .premium-benefits .features li {
            background: rgba(255,255,255,0.1);
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .cta-box {
            background: rgba(243, 156, 18, 0.2);
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid #f39c12;
        }

       

    </style>
</head>

<body>
    <div class="container">
        <!-- Sol Bölüm -->
        <div class="left-section">
            <div>
                <div class="logo">SÖNMEZ LEZZET DÜNYASI</div>
                <div class="left-content">
                    <h2>Unutulmaz Bir Lezzet Yolculuğuna Çıkın!</h2>
                    <p class="highlight-text">Her lokmada bir hikaye, her ziyarette bir anı biriktirdiğimiz sofralarımıza hoş geldiniz. Ailenizin ikinci evi olmaya hazırız!</p>

                    <div class="premium-benefits">
                        <ul class="features">
                            <li><i class="fas fa-bolt"></i> Anında rezervasyon onayı</li>
                            <li><i class="fas fa-gift"></i> Doğum gününüzde özel sürpriz</li>
                            <li><i class="fas fa-star"></i> Öncelikli masa tahsisi</li>
                            <li><i class="fas fa-percent"></i> %25'e varan özel indirimler</li>
                            <li><i class="fas fa-wine-glass-alt"></i> Şefin özel menüsünden tadımlık</li>
                        </ul>
                    </div>

                    <div class="cta-box">
                        <p><i class="fas fa-magic"></i> Hemen katılın, lezzet dolu dünyamızın kapılarını aralayın!</p>
                    </div>
                </div>
            </div>
            
            <a href="/Login/Index" class="btn-outline">Hadi Başlayalım</a>
        </div>
        
        <!-- Sağ Bölüm -->
        <div class="right-section">
            <div class="form-header">
                <h2>Bize Katılın</h2>
                <p>Hemen ücretsiz hesap oluşturun :)</p>
            </div>
            
            <form method="post" class="signin-form" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                
                <div class="form-group">
                    <label for="Name">Adınız</label>
                    <input type="text" id="Name" asp-for="Name" class="form-control" placeholder="Adınızı girin" required>
                    <span class="text-danger" asp-validation-for="Name"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                
                <div class="form-group">
                    <label for="Surname">Soyadınız</label>
                    <input type="text" id="Surname" asp-for="Surname" class="form-control" placeholder="Soyadınızı girin" required>
                    <span class="text-danger" asp-validation-for="Surname"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                
                <div class="form-group">
                    <label for="UserName">Kullanıcı Adınız</label>
                    <input type="text" id="UserName" asp-for="UserName" class="form-control" placeholder="Kullanıcı adınızı girin" required>
                    <span class="text-danger" asp-validation-for="UserName"></span>
                    <i class="fas fa-user input-icon"></i>
                </div>
                
                <div class="form-group">
                    <label for="Mail">E-posta Adresiniz</label>
                    <input type="email" id="Mail" asp-for="Mail" class="form-control" placeholder="E-posta adresinizi girin" required>
                    <span class="text-danger" asp-validation-for="Mail"></span>
                    <i class="fas fa-at input-icon"></i>
                </div>
                
                <div class="form-group">
                    <label for="Password">Şifre</label>
                    <input type="password" id="Password" asp-for="Password" class="form-control" placeholder="Şifrenizi girin" required>
                    <span class="text-danger" asp-validation-for="Password"></span>
                    <i class="fas fa-lock input-icon"></i>
                </div>
                
                <div class="checkbox-container">
                    <input type="checkbox" id="terms" required>
                    <label for="terms">
                        <a href="#" id="termsLink" style="text-decoration:none">Şartları</a> okudum ve kabul ediyorum
                    </label>
                </div>
                
                <button type="submit" class="btn-primary">Kayıt Ol</button>
                
                <div class="login-link">
                    Zaten hesabınız var mı? <a href="/Login/Index" style="text-decoration:none">Giriş Yapın</a>
                </div>
            </form>
            
            <div class="copyright">
                <p>© @DateTime.Now.Year SignalR Restaurant. Tüm hakları saklıdır.</p>
            </div>
        </div>
    </div>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const termsLink = document.getElementById('termsLink');
            
            // Form gönderimini dinle
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Form doğrulama
                const name = document.getElementById('Name').value;
                const surname = document.getElementById('Surname').value;
                const username = document.getElementById('UserName').value;
                const email = document.getElementById('Mail').value;
                const password = document.getElementById('Password').value;
                const terms = document.getElementById('terms').checked;
                
                if (!terms) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Şartlar Kabul Edilmeli',
                        text: 'Devam etmek için şartları kabul etmelisiniz.',
                        confirmButtonColor: '#e74c3c'
                    });
                    return;
                }
                
                // Başarılı kayıt simülasyonu
                Swal.fire({
                    title: 'Kayıt İşlemi Yapılıyor',
                    text: 'Lütfen bekleyin...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // Gerçek form gönderimini simüle et
                setTimeout(() => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Kayıt Başarılı!',
                        text: 'Hesabınız başarıyla oluşturuldu. Giriş yapabilirsiniz.',
                        confirmButtonColor: '#27ae60'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Gerçek form gönderimi
                            form.submit();
                        }
                    });
                }, 2000);
            });
            
            // Şartlar linki tıklama
            termsLink.addEventListener('click', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Kullanım Şartları',
                    html: `
                        <div style="text-align: left; max-height: 400px; overflow-y: auto;">
                            <h4>1. Üyelik Koşulları</h4>
                            <p>Restoranımıza üye olarak aşağıdaki koşulları kabul etmiş sayılırsınız:</p>
                            <ul>
                                <li>Doğru ve güncel bilgiler sağlamayı taahhüt edersiniz.</li>
                                <li>Hesabınızın güvenliğinden siz sorumlusunuz.</li>
                                <li>Rezervasyon iptal politikalarımıza uymayı kabul edersiniz.</li>
                            </ul>
                            
                            <h4>2. Gizlilik Politikası</h4>
                            <p>Kişisel verileriniz 6698 sayılı KVKK kapsamında korunmaktadır.</p>
                            
                            <h4>3. Kampanya ve İndirimler</h4>
                            <p>Üyelere özel kampanyalar ve indirimlerden yararlanma hakkına sahipsiniz.</p>
                        </div>
                    `,
                    width: 600,
                    confirmButtonText: 'Anladım',
                    confirmButtonColor: '#e74c3c'
                });
            });
        });
    </script>
</body>
</html>