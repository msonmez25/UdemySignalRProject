@model CreateMailDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Mail Gönderme Paneli</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label >Alıcı Mail Adresi</label>
                                <input type="text" class="form-control" asp-for="ReceiverMail" >
                            </div>
                            <div class="form-group">
                                <label >Konu</label>
                                <input type="text" class="form-control" asp-for="Subject">
                            </div>
                            <div class="form-group">
                                <label >Mesajınız</label>
                                <textarea rows="5" asp-for="Body" class="form-control"></textarea>
                            </div>
                            <div class="card-action">
                                <button class="btn btn-primary">Maili Gönder</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

