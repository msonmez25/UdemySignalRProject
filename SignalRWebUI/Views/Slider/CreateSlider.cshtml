@model CreateSliderDto
@{
    ViewData["Title"] = "CreateSlider";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Öne Çıkan Slider Ekleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <div class="form-group">
                                <label>1. Başlık</label>
                                <input type="text" class="form-control" asp-for="Title1">
                            </div>

                            <div class="form-group">
                                <label>1. Açıklama</label>
                                <input type="text" class="form-control" asp-for="Description1">
                            </div>

                            <div class="form-group">
                                <label>2. Başlık</label>
                                <input type="text" class="form-control" asp-for="Title2">
                            </div>

                            <div class="form-group">
                                <label>2. Açıklama</label>
                                <input type="text" class="form-control" asp-for="Description2">
                            </div>

                            <div class="form-group">
                                <label>3. Başlık</label>
                                <input type="text" class="form-control" asp-for="Title3">
                            </div>

                            <div class="form-group">
                                <label>3. Açıklama</label>
                                <input type="text" class="form-control" asp-for="Description3">
                            </div>


                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Öne Çıkan Slider Yazısı Ekle</button>
                            <a href="/Slider/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>




