@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<div class="content">
    <div class="container-fluid">

        <script type="text/javascript">

            $(document).ready(() => {

                var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7195/SignalRHub").build();
                $("#connstatus").text(connection.state);

                connection.start().then(() => {
                    $("#connstatus").text(connection.state);
                    setInterval(() => {
                        connection.invoke("SendProgress");
                    }, 1000);

                }).catch((err) => { console.log(err) });

                //---------------------------------------------------------------------------
                //Sol Taraf
                //Son Sipariş Tutarı
                connection.on("ReceiveLastOrderPrice", (value) => {
                    $("#receiveLastOrderPrice").text(value);
                });

                //Bugünki Kazanç Tutarı
                connection.on("ReceiveTodayTotalPrice", (value) => {
                    $("#receiveTodayTotalPrice").text(value);
                });

                //Kasadaki Toplam Tutar
                connection.on("ReceiveTotalMoneyCaseAmount", (value) => {
                    $("#totalmoneycaseamount").text(value);
                });




                //---------------------------------------------------------------------------
                //Orta Taraf
                //En Pahalı Ürün Fiyatı ProgressBar
                connection.on("ReceiveProductPriceMax", (value) => {
                    let max = 500;
                    let percent = (value / max) * 100;
                    $('#receiveProductPriceMax').empty();
                    $('#receiveProductPriceMax').append(`
                                                                        <div class="d-flex justify-content-between mb-1">
                                                                        <span class="text-muted">En Pahalı Ürün Fiyatı</span>
                                                                                    <span class="text-muted fw-bold"> ${value} ₺</span>
                                                                        </div>
                                        <div class="progress mb-2" style="height: 7px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: ${percent}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${percent}%"></div>
                                                                        </div>
                                                                    `)
                });

                //En Pahalı Ürün
                connection.on("ReceiveProductNameByPriceMax", (value) => {
                    $('#receiveProductNameByPriceMax').empty();
                    $('#receiveProductNameByPriceMax').append(`
                                                                                    <div class="d-flex justify-content-between mb-1">
                                                                                    <span class="text-muted">En Pahalı Ürün</span>
                                                                                                <span class="text-muted fw-bold"> ${value}</span>
                                                                                    </div>
                                                                                                 <div class="progress mb-2" style="height: 7px;">

                                                            </div>
                                                                                `)
                });

                //Ortalama Ürün Fiyatı ProgressBar
                connection.on("ReceiveProductPriceAvg", (value) => {
                    let max = 500;
                    let percent = (value / max) * 100;
                    $('#receiveProductPriceAvgProgress').empty();
                    $('#receiveProductPriceAvgProgress').append(`
                                                <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Ortalama Ürün Fiyatı</span>
                                                            <span class="text-muted fw-bold"> ${value}</span>
                                                </div>
                                                <div class="progress mb-2" style="height: 7px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: ${percent}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="500" data-toggle="tooltip" data-placement="top" title="${percent}%"></div>
                                                </div>
                                            `)
                });

                //En Ucuz Ürün Fiyatı ProgressBar
                connection.on("ReceiveProductPriceMin", (value) => {
                    let max = 500;
                    let percent = (value / max) * 100;
                    $('#receiveProductPriceMin').empty();
                    $('#receiveProductPriceMin').append(`
                                                                                    <div class="d-flex justify-content-between mb-1">
                                                                                    <span class="text-muted">En Ucuz Ürün Fiyatı</span>
                                                                                                <span class="text-muted fw-bold"> ${value} ₺</span>
                                                                                    </div>
                                                                                    <div class="progress mb-2" style="height: 7px;">
                                                                                                            <div class="progress-bar bg-warning" role="progressbar" style="width: ${percent}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="500" data-toggle="tooltip" data-placement="top" title="${percent}%"></div>
                                                                                    </div>
                                                                                `)
                });

                //En Ucuz Ürün
                connection.on("ReceiveProductNameByPriceMin", (value) => {
                    $('#receiveProductNameByPriceMin').empty();
                    $('#receiveProductNameByPriceMin').append(`
                                                                                                <div class="d-flex justify-content-between mb-1">
                                                                                                <span class="text-muted">En Ucuz Ürün</span>
                                                                                                            <span class="text-muted fw-bold"> ${value}</span>
                                                                                                </div>
                                                                                                             <div class="progress mb-2" style="height: 7px;">

                                                                        </div>
                                                                                            `)
                });

                //Ortalama Hamburger Fiyatı ProgressBar
                connection.on("ReceiveProductAvgPriceByHamburger", (value) => {
                    let max = 500;
                    let percent = (value / max) * 100;
                    $('#receiveProductAvgPriceByHamburgerProgress').empty();
                    $('#receiveProductAvgPriceByHamburgerProgress').append(`
                                 <div class="d-flex justify-content-between mb-1">
                                 <span class="text-muted">Ortalama Hamburger Fiyatı</span>
                                 <span class="text-muted fw-bold"> ${value} ₺</span>
                                 </div>
                                 <div class="progress mb-2" style="height: 7px;">
                                                         <div class="progress-bar bg-primary" role="progressbar" style="width: ${percent}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${percent}%"></div>
                                                            </div>
                                                        `)
                });

                //İçecek Sayısı ProgressBar
                connection.on("ReceiveProductCountByCategoryNameDrink", (value) => {
                    $('#receiveProductCountByCategoryNameDrinkProgress').empty();
                    $('#receiveProductCountByCategoryNameDrinkProgress').append(`
                                 <div class="d-flex justify-content-between mb-1">
                                 <span class="text-muted">Toplam İçecek Sayısı</span>
                                 <span class="text-muted fw-bold"> ${value}</span>
                                 </div>
                                 <div class="progress mb-2" style="height: 7px;">
                                 <div class="progress-bar bg-warning" role="progressbar" style="width: ${value}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value}%"></div>
                                                                        </div>
                                                                    `)
                });

                //Toplam Sipariş Sayısı ProgressBar
                connection.on("ReceiveTotalOrderCount", (value) => {
                    $('#receiveTotalOrderCountProgress').empty();
                    $('#receiveTotalOrderCountProgress').append(`
                                             <div class="d-flex justify-content-between mb-1">
                                             <span class="text-muted">Toplam Sipariş Sayısı</span>
                                             <span class="text-muted fw-bold"> ${value}</span>
                                             </div>
                                             <div class="progress mb-2" style="height: 7px;">
                                             <div class="progress-bar bg-success" role="progressbar" style="width: ${value}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value}%"></div>
                                                                                    </div>
                                                                                `)
                });

                //Aktif Sipariş Sayısı ProgressBar
                connection.on("ReceiveActiveOrderCount", (value) => {
                    $('#receiveActiveOrderCountProgress').empty();
                    $('#receiveActiveOrderCountProgress').append(`
                                                         <div class="d-flex justify-content-between mb-1">
                                                         <span class="text-muted">Aktif Sipariş Sayısı</span>
                                                         <span class="text-muted fw-bold"> ${value}</span>
                                                         </div>
                                                         <div class="progress mb-2" style="height: 7px;">
                                                         <div class="progress-bar bg-info" role="progressbar" style="width: ${value}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value}%"></div>
                                                                                                </div>
                                                                                            `)
                });

                //Toplam Masa Sayısı ProgressBar
                connection.on("ReceiveCountTable", (value) => {
                    $('#totalMenuTableCountProgress').empty();
                    $('#totalMenuTableCountProgress').append(`
                                                <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Toplam Masa Sayısı</span>
                                                            <span class="text-muted fw-bold"> ${value}</span>
                                                </div>
                                                <div class="progress mb-2" style="height: 7px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: ${value}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value}%"></div>
                                                </div>
                                            `)
                });


                //---------------------------------------------------------------------------
                //Sağ Taraf
                //Aktif Sipariş Sayısı
                connection.on("ReceiveActiveOrderCount", (value) => {
                    $("#activeordercount").text(value);
                });

                //Toplam Masa Sayısı
                connection.on("ReceiveCountTable", (value) => {
                    $("#counttable").text(value);
                });

                //Kategori Sayısı
                connection.on("ReceiveCategoryCount", (value) => {
                    $("#receiveCategoryCount").text(value);
                });

                //Ürün Sayısı
                connection.on("ReceiveProductCount", (value) => {
                    $("#receiveProductCount").text(value);
                });

                //Rezervasyon Sayısı
                connection.on("ReceiveTotalBookingCount", (value) => {
                    $("#receiveTotalBookingCount").text(value);
                });

                //Onaylanmış Rezervasyon Sayısı
                connection.on("ReceiveOnaylanmisBookingCount", (value) => {
                    $("#receiveOnaylanmisBookingCount").text(value);
                });

                //İptal Edilmiş Rezervasyon Sayısı
                connection.on("ReceiveIptalEdilmisBookingCountt", (value) => {
                    $("#receiveIptalEdilmisBookingCountt").text(value);
                });

                //Onaylanmamış Rezervasyon Sayısı
                connection.on("ReceiveOnaylanmamisBookingCount", (value) => {
                    $("#receiveOnaylanmamisBookingCount").text(value);
                });

            });
        </script>



        <h4 class="page-title">Admin İstatistikler & Durumlar</h4>
        <div class="row row-card-no-pd">

            <!--SOL Taraf - Anlık Durumlar-->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <p class="fw-bold mt-1">Son Sipariş Tutarı</p>
                        <h4 id="receiveLastOrderPrice"><b></b></h4>
                    </div>
                    <hr />
                    <div class="card-body">
                        <p class="fw-bold mt-1">Bugünki Kazanç</p>
                        <h4 id="receiveTodayTotalPrice"><b></b></h4>
                    </div>
                    <hr />
                    <div class="card-body">
                        <p class="fw-bold mt-1">Kasadaki Toplam Tutar</p>
                        <h4 id="totalmoneycaseamount"><b></b></h4>
                        <a href="/Order/CreateOrder/" class="btn btn-primary btn-full text-left mt-3 mb-3"><i class="la la-plus"></i> Yeni Sipariş</a>
                    </div>
                    <div class="card-footer">
                        <ul class="nav">
                            <li class="nav-item"><a class="btn btn-default btn-link" href="/Order/Index/"><i class="la la-history"></i> Siparişler</a></li>
                            <li class="nav-item ml-auto"><a class="btn btn-default btn-link" href="/ProgressBars/Index/"><i class="la la-refresh"></i> Sayfayı Yenile</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!--ORTA Taraf - Anlık Durumlar-->
            <div class="col-md-5">
                <div class="card">
                    <div class="card-body">

                        <!--En Pahalı Ürün Fiyatı ProgressBar-->
                        <div class="progress-card" id="receiveProductPriceMax"></div>

                        <!--En Pahalı Ürün-->
                        <div class="progress-card" id="receiveProductNameByPriceMax"></div>

                        <!--Ortalama Ürün Fiyatı ProgressBar-->
                        <div class="progress-card" id="receiveProductPriceAvgProgress"></div>

                        <!--En Ucuz Ürün Fiyatı ProgressBar-->
                        <div class="progress-card" id="receiveProductPriceMin"></div>

                        <!--En Pahalı Ürün-->
                        <div class="progress-card" id="receiveProductNameByPriceMin"></div>

                        <!--Ortalama Hamburger Fiyatı ProgressBar-->
                        <div class="progress-card" id="receiveProductAvgPriceByHamburgerProgress"></div>

                        <!--Toplam İçecek ProgressBar-->
                        <div class="progress-card" id="receiveProductCountByCategoryNameDrinkProgress"></div>

                        <!--Toplam Sipariş ProgressBar-->
                        <div class="progress-card" id="receiveTotalOrderCountProgress"></div>

                        <!--Aktif Sipariş ProgressBar-->
                        <div class="progress-card" id="receiveActiveOrderCountProgress"></div>

                        <!--Toplam Masa Sayısı ProgressBar-->
                        <div class="progress-card" id="totalMenuTableCountProgress"></div>

                    </div>
                </div>
            </div>

            <!--SAĞ Taraf - Anlık Durumlar-->
            <div class="col-md-3">
                <div class="card card-stats">
                    <div class="card-body">
                        <p class="fw-bold mt-1">İstatistikler</p>

                        <hr />
                        <!--Toplam Kategori Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-connectdevelop text-success"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Kategori Sayısı</p>
                                    <h4 class="card-title" id="receiveCategoryCount"></h4>
                                </div>
                            </div>
                        </div>

                        <hr />
                        <!--Toplam Ürün Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-cubes text-dark"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Ürün Sayısı</p>
                                    <h4 class="card-title" id="receiveProductCount"></h4>
                                </div>
                            </div>
                        </div>

                        <hr />
                        <!--Toplam Rezervasyon Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-calendar text-danger"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Tüm Rezervasyonlar</p>
                                    <h4 class="card-title" id="receiveTotalBookingCount"></h4>
                                </div>
                            </div>
                        </div>

                        <!--Onaylanmış Rezervasyon Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-calendar-check-o text-danger"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Onaylanmış Rezervasyon</p>
                                    <h4 class="card-title" id="receiveOnaylanmisBookingCount"></h4>
                                </div>
                            </div>
                        </div>

                        <!--İptal Edilmiş Rezervasyon Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-calendar-times-o text-danger"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">İptal Edilmiş Rezervasyon</p>
                                    <h4 class="card-title" id="receiveIptalEdilmisBookingCountt"></h4>
                                </div>
                            </div>
                        </div>

                        <!--Onaylanmamış Rezervasyon Sayısı-->
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-calendar-minus-o text-danger"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Onaylanmamış Rezervasyon</p>
                                    <h4 class="card-title" id="receiveOnaylanmamisBookingCount"></h4>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

