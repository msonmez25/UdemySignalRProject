@model CreateContactDto
@{
    ViewData["Title"] = "CreateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Ana Sayfa İletişim Bilgisi Ekleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <div class="form-group">
                                <label>Lokasyon</label>
                                <input type="text" class="form-control" asp-for="Location">
                            </div>

                            <div class="form-group">
                                <label>Telefon</label>
                                <input type="tel" class="form-control" asp-for="Phone">
                            </div>

                            <div class="form-group">
                                <label>Mail</label>
                                <input type="email" class="form-control" asp-for="Mail">
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="FooterDescription" rows="3"></textarea>
                            </div>

                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">İletişim Bİlgisi Ekle</button>
                            <a href="/Contact/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>




