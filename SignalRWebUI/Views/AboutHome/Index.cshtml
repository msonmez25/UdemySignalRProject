@model List<ResultAboutDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeadComponentPartial")

<body class="sub_page">

    @await Component.InvokeAsync("_UILayoutNavbarComponentPartial")
    </div>

    <!-- About Inside Start  -->
    @foreach (var item in Model)
    {
        <section class="about_section layout_padding">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Görsel -->
                    <div class="col-md-6 mb-4 mb-md-0">
                        <div class="img-box shadow rounded-3 overflow-hidden">
                            <img src="@item.ImageUrl" alt="@item.Title" class="img-fluid">
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="col-md-6">
                        <div class="detail-box">
                            <div class="heading_container"> <h2> @item.Title </h2> </div>

                            <!-- Açıklama Metni -->
                            <p style="text-align: justify; line-height: 1.7; font-size: 1.05rem;">
                                @Html.Raw(item.Description.Replace("\n", "<br />"))
                            </p>

                            <!-- Buton -->
                            <a href="/FoodRapidApi/Index/" class="btn btn-warning mt-3 px-4 py-2 rounded-pill text-white fw-bold">
                                Dünya Mutfağını Gör
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- About Inside End -->
    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")
    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

</body>
</html>
