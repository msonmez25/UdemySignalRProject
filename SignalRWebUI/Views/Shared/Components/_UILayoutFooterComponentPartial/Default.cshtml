@model List<ResultContactDto>

<footer class="footer_section">
    <div class="container">
        <div class="row">
            <div class="col-md-4 footer-col">
                <div class="footer_contact">
                    <h4>
                        İletişim
                    </h4>
                    @foreach(var item in Model)
                    {     
                    <div class="contact_link_box">
                        <a href="">
                            <i class="fa fa-map-marker" aria-hidden="true"></i>
                            <span>
                                @item.Location
                            </span>
                        </a>
                        <a href="">
                            <i class="fa fa-phone" aria-hidden="true"></i>
                            <span>
                               @item.Phone
                            </span>
                        </a>
                        <a href="">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                            <span>
                                @item.Mail
                            </span>
                        </a>
                    </div>
                    }

                </div>
            </div>
            <div class="col-md-4 footer-col">
                <div class="footer_detail">
                    <a href="" class="footer-logo">
                        SÖNMEZ
                    </a>
                    <p>
                        @ViewBag.FooterDescription
                    </p>
                    <!-- footer sosyal medya start -->
                    @await Component.InvokeAsync("_UILayoutFooterSocialMediaComponentPartial")                   
                    <!-- footer sosyal medya end -->
                </div>
            </div>

            <!-- footer right start -->
            @await Component.InvokeAsync("_UILayoutFooterOpenInfoComponentPartial")            
            <!-- footer right end -->
        </div>
        <div class="footer-info">
            <p>
                &copy; <span id="displayYear"></span> Tüm Hakları Saklıdır.
                <a href="https://html.design/">SignalR Restourant</a><br><br>
                &copy; <span id="displayYear"></span> Geliştiren
                <a href="https://themewagon.com/" target="_blank">Sönmez Yazılım Akademi</a>
            </p>
        </div>
    </div>
</footer>