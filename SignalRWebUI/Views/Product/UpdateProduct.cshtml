@model UpdateProductDto
@{
    ViewData["Title"] = "UpdateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Ürün Güncelleme İşlemleri</div>
                        </div>
                        <div class="card-body">
                            <input type="hidden" asp-for="ProductID" />
                            <div class="form-group">
                                <label>Ürün Adı</label>
                                <input type="text" class="form-control" asp-for="ProductName">
                            </div>

                            <div class="form-group">
                                <label>Ürün Kategorisi</label>
                                @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.CategoryName, new { @class = "form-control" })
                            </div>

                            <div class="form-group">
                                <label>Fiyatı</label>
                                <input type="text" class="form-control" asp-for="Price">
                            </div>

                            <div class="form-group">
                                <label>Görsel Url</label>
                                <input type="text" class="form-control" asp-for="ImageUrl">
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <textarea id="basic-default-message"
                                          class="form-control" asp-for="Description" rows="3"></textarea>
                            </div>



                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Ürünü Güncelle</button>
                            <a href="/Product/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>



