@model List<ResultProductDto>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Ürün Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub mb-3">
                            Ürünler ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz.
                        </div>

                        <table id="productTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>Ürün Adı</th>
                                    <th>Kategori</th>
                                    <th>Fiyat</th>
                                    <th>Durum</th>
                                    <th>Durum Değiştir</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.ProductName</td>
                                        <td>@item.CategoryName</td>
                                        <td>@item.Price.ToString("0.00") ₺</td>
                                        <td>@(item.ProductStatus ? "Aktif" : "Kapalı")</td>

                                        <td>
                                            @if (item.ProductStatus)
                                            {
                                                <a href="/Product/ProductStatusChangeFalse/@item.ProductID" class="btn btn-dark btn-sm">
                                                    Pasif Yap
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="/Product/ProductStatusChangeTrue/@item.ProductID" class="btn btn-warning btn-sm">
                                                    Aktif Yap
                                                </a>
                                            }
                                        </td>

                                        <td>
                                            <a href="/Product/DeleteProduct/@item.ProductID"
                                               class="btn btn-danger btn-sm"
                                               onclick="return confirm('Bu ürünü silmek istediğinizden emin misiniz?');">
                                                Sil
                                            </a>
                                        </td>

                                        <td>
                                            <a href="/Product/UpdateProduct/@item.ProductID" class="btn btn-success btn-sm">
                                                Güncelle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <br />
                        <a href="/Product/CreateProduct" class="btn btn-primary mt-3">Yeni Ürün Ekle</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                responsive: true
            });
        });
    </script>
}
