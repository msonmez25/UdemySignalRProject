@model List<ResultOrdersWithTableNameDto>
@{
    ViewData["Title"] = "Siparişlerim";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        @section Scripts {
            <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
            <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
            <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

            <script>
                $(document).ready(() => {

                    var connection = new signalR.HubConnectionBuilder()
                        .withUrl("https://localhost:7195/SignalRHub")
                        .withAutomaticReconnect()
                        .build();

                    var orderTable;

                    connection.on("ReceiveGetOrdersList", (orders) => {
                        console.log("Veriler geldi:", orders);

                        // 📌 Tarihe göre son gelen en üstte olacak şekilde sırala
                        orders = orders.sort((a, b) => new Date(b.date) - new Date(a.date));

                        if (!$.fn.DataTable.isDataTable("#orderTable")) {
                            let tableHtml = `
                                        <table id="orderTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Sipariş No / Masa-ID</th>
                                                    <th>Masa Adı</th>
                                                    <th>Sipariş Tutarı</th>
                                                    <th>Sipariş Tarihi</th>
                                                    <th>Detay</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>`;

                            $("#orderlist").html(tableHtml);

                            orderTable = $("#orderTable").DataTable({
                                language: {
                                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                                },
                                responsive: true
                            });
                        }

                        orderTable.clear();

                        orders.forEach((item, i) => {
                            orderTable.row.add([
                                i + 1,
                                item.orderID + " / " + item.tableNumber,
                                item.restaurantTableName ?? "—",
                                item.totalPrice.toFixed(2) + " ₺",
                                new Date(item.date).toLocaleString("tr-TR"),
                                `<a href="/OrderDetail/Index/${item.orderID}" class="btn btn-outline-info btn-sm">
                                            <i class="fa-solid fa-eye"></i> Gör
                                        </a>`
                            ]);
                        });

                        orderTable.draw(false);
                    });

                    async function startConnection() {
                        try {
                            await connection.start();
                            console.log("SignalR bağlantısı kuruldu ✅");
                            connection.invoke("GetOrdersList");
                        } catch (err) {
                            console.warn("Bağlantı kurulamadı, tekrar deneniyor...");
                            setTimeout(startConnection, 2000);
                        }
                    }

                    startConnection();

                    setInterval(() => {
                        if (connection.state === "Connected") {
                            connection.invoke("GetOrdersList");
                        }
                    }, 5000);

                });
            </script>

        }



        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Siparişlerim</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub mb-2">
                            Sipariş geçmişinizi aşağıdan görüntüleyebilirsiniz.
                        </div>
                        <div id="orderlist"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
