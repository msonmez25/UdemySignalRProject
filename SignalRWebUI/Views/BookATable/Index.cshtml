@model CreateBookingDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeadComponentPartial")

<body class="sub_page">

    @await Component.InvokeAsync("_UILayoutNavbarComponentPartial")
    </div>

    <!-- Book A Table Inside Start  -->
 
    <section class="book_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h2>
                    Rezervasyon Oluşturun
                </h2>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form_container">
                        <form method="post">


                            <div>
                                <input type="text" class="form-control" placeholder="Adınız Soyadınız" id="nameInput" asp-for="Name"  />
                                @* <span asp-validation-for="Name" class="text-danger"></span> *@
                            </div>
                            <div>
                                <input type="text" class="form-control" placeholder="Telefon Numaranız" id="phoneInput" asp-for="Phone"  />
                                @* <span asp-validation-for="Phone" class="text-danger"></span> *@
                            </div>
                            <div>
                                <input type="email" class="form-control" placeholder="Mail Adresiniz" id="mailInput" asp-for="Mail"  />
                                @* <span asp-validation-for="Mail" class="text-danger"></span> *@
                            </div>
                            <div>
                                @* <select class="form-control nice-select wide" asp-for="PersonCount" required >
                                    <option value="" disabled selected>
                                        Kaç Kişiniz?
                                    </option>
                                    <option value="1">
                                        1
                                    </option>
                                    <option value="2">
                                        2
                                    </option>
                                    <option value="3">
                                        3
                                    </option>
                                    <option value="4">
                                        4
                                    </option>
                                    <option value="5">
                                        5
                                    </option>
                                    <option value="6">
                                        6 ++
                                    </option>
                                </select> *@
                                @* <span asp-validation-for="PersonCount" class="text-danger"></span> *@

                                <select id="personSelect" class="form-control nice-select wide" asp-for="PersonCount" >
                                    <option value="" disabled selected hidden>Kaç Kişiniz?</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6 ++</option>
                                </select>

                            </div>
                            <div>
                                @* <input type="date" class="form-control" asp-for="Date" required> *@
                                @* <span asp-validation-for="Date" class="text-danger"></span> *@
                                <input type="date" id="dateInput" class="form-control" asp-for="Date" >
                            </div>
                            <div class="btn_box">
                                <button id="btnbooking">
                                    Rezervasyonu Tamamla
                                </button>
                            </div>
                         
                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="map_container ">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2530.2188536892018!2d28.918783066742755!3d41.048129263766675!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab1bcf607ae4b%3A0x3adb57b070b269a0!2zUmFtaSBLw7x0w7xwaGFuZXNpIEEgS2FwxLFzxLEgKEjDvG5rYXIgS2FwxLFzxLEp!5e0!3m2!1str!2str!4v1760072068390!5m2!1str!2str" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Book A Table Inside End -->

    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")

    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

    <!-- SweetAlert2 -->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="text/javascript">
        $("#btnbooking").click(function () {
            const name = $("#nameInput").val();
            const phone = $("#phoneInput").val();
            const mail = $("#mailInput").val();
            const select = $("#personSelect").val();
            const date = $("#dateInput").val();
           

            if (!name) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen Ad Soyad giriniz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            if (!phone) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen telefon giriniz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            if (!mail) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen mail giriniz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            if (!select) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen kişi sayısını seçiniz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            if (!date) {
                Swal.fire({
                    icon: "warning",
                    title: "Eksik Bilgi!",
                    text: "Lütfen tarih seçiniz.",
                    confirmButtonText: "Tamam"
                });
                return;
            }

            // Başarılı popup
            Swal.fire({
                title: "<strong>Tebrikler!</strong>",
                text: "Rezervasyon Kaydedildi!",
                icon: "success",
                timer: 2500,
                showConfirmButton: false
            }).then(() => {
                window.location.href = "/Default/Index/";
            });
        });
    </script>


</body>

</html>