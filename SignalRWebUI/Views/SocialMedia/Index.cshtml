@model List<ResultSocialMediaDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Sosyal Medya Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Sosyal Medya alanı ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz. 
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Durumu</th>
                                    <th scope="col">Durumu Değiştir</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Title</td>
                                        @if (@item.Status == true)
                                        {
                                            <td>Aktif</td>
                                        }
                                        else
                                        {
                                            <td>Kapalı</td>
                                        }
                                        @if (@item.Status == true)
                                        {
                                            <td><a href="/SocialMedia/SocialMediaStatusChangeFalse/@item.SocialMediaID" class="btn btn-dark">Pasif Yap</a></td>
                                        }
                                        else
                                        {
                                            <td><a href="/SocialMedia/SocialMediaStatusChangeTrue/@item.SocialMediaID" class="btn btn-warning">Aktif Yap</a></td>
                                        }
                                        <td><a href="/SocialMedia/DeleteSocialMedia/@item.SocialMediaID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/SocialMedia/UpdateSocialMedia/@item.SocialMediaID" class="btn btn-success">Güncelle</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>

                        <a href="/SocialMedia/CreateSocialMedia" class="btn btn-primary">Yeni Sosyal Medya Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


