@model List<ResultSocialMediaDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Sosyal Medya Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Sosyal Medya alanı ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz. 
                        </div>
                        <table id="socialMediaTable" class="table table-head-bg-success table-hover table-bordered mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>Başlık</th>
                                    <th>Durumu</th>
                                    <th>Durumu Değiştir</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Title</td>
                                        @if (@item.Status == true)
                                        {
                                            <td>Aktif</td>
                                        }
                                        else
                                        {
                                            <td>Kapalı</td>
                                        }
                                        @if (@item.Status == true)
                                        {
                                            <td><a href="/SocialMedia/SocialMediaStatusChangeFalse/@item.SocialMediaID" class="btn btn-dark">Pasif Yap</a></td>
                                        }
                                        else
                                        {
                                            <td><a href="/SocialMedia/SocialMediaStatusChangeTrue/@item.SocialMediaID" class="btn btn-warning">Aktif Yap</a></td>
                                        }
                                        <td>
                                            <a href="/SocialMedia/DeleteSocialMedia/@item.SocialMediaID" class="btn btn-danger" 
                                            onclick="return confirm('Bu yazıyı silmek istediğinizden emin misiniz?');">
                                                Sil
                                            </a>
                                        </td>
                                        <td><a href="/SocialMedia/UpdateSocialMedia/@item.SocialMediaID" class="btn btn-success">Güncelle</a></td>

                                    </tr>
                                }


                            </tbody>
                        </table>
                        <br />
                        <a href="/SocialMedia/CreateSocialMedia" class="btn btn-primary">Yeni Sosyal Medya Ekle</a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- DataTables Türkçe -->
    <script>
        $(document).ready(function () {
            $('#socialMediaTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                responsive: true
            });
        });
    </script>
}