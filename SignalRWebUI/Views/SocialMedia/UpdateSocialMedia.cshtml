@model UpdateSocialMediaDto
@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Ana Sayfa Hakkımızda Yazısı Güncelleme İşlemleri</div>
                        </div>
                        <div class="card-body">

                            <input type="hidden" asp-for="SocialMediaID"/>
                            <div class="form-group">
                                <label>Başlık</label>
                                <input type="text" class="form-control" asp-for="Title">
                            </div>

                            <div class="form-group">
                                <label>İkon</label>
                                <input type="text" class="form-control" asp-for="Icon">
                            </div>

                            <div class="form-group">
                                <label>Link</label>
                                <input type="text" class="form-control" asp-for="Url">
                            </div>

                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Sosyal Medya Güncelle</button>
                            <a href="/SocialMedia/Index" class="btn btn-danger">İptal Et</a>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>



